# Copy to .env and fill in. Never commit .env. This repository is public.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
RUNWAYML_API_SECRET=

# ElevenLabs voice ids to narrate with (pick in the ElevenLabs voice library)
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_FIL=

# Hard ceiling for provider spend in a single run, in US dollars
MAX_RUN_USD=5
# Path to Chrome for rendering (leave empty to let Remotion download its own)
CHROME_PATH=
